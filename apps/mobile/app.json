{
  "expo": {
    "name": "CADO",
    "slug": "cadolebanon",
    "scheme": "cado",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F6F1E7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cado.app"
    },
    "android": {
      "package": "com.cado.app",
      "adaptiveIcon": {
        "backgroundColor": "#F94E33",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "328d466f-b354-458e-a309-ff245a0735b8"
      }
    },
    "plugins": [
      "expo-router",
      "./plugins/withAndroidKeyboardResize.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F94E33"
        }
      ]
    ]
  }
}
